# Application
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/securityscan

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Encryption (for target credentials)
ENCRYPTION_KEY=change-me-32-byte-hex-key-here!!

# Logging
LOG_LEVEL=info

# Scanner defaults
DEFAULT_MAX_REQUESTS_PER_SECOND=10
DEFAULT_MAX_CONCURRENCY=5
DEFAULT_MAX_REQUESTS=10000
DEFAULT_MAX_CRAWL_DEPTH=5
DEFAULT_MAX_RESPONSE_SIZE=10485760
DEFAULT_MAX_SCAN_DURATION=3600
DEFAULT_TIMEOUT_PER_REQUEST=30
