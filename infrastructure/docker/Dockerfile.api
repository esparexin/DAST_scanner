FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/shared/package.json packages/shared/
COPY packages/scope/package.json packages/scope/
COPY packages/http-client/package.json packages/http-client/
COPY packages/database/package.json packages/database/
COPY packages/payload-engine/package.json packages/payload-engine/
COPY packages/knowledge-base/package.json packages/knowledge-base/
COPY packages/ai/package.json packages/ai/
COPY packages/detection-engine/package.json packages/detection-engine/
COPY packages/finding-engine/package.json packages/finding-engine/
COPY packages/evidence-engine/package.json packages/evidence-engine/
COPY packages/risk-engine/package.json packages/risk-engine/
COPY packages/verification-engine/package.json packages/verification-engine/
COPY packages/scanner-core/package.json packages/scanner-core/
COPY packages/reporting/package.json packages/reporting/
COPY packages/crawler/package.json packages/crawler/
COPY packages/storage/package.json packages/storage/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --prod=false

# Build
FROM deps AS builder
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN pnpm --filter @securityscan/api... build

# Production image
FROM node:20-alpine AS runner
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3001/api/health || exit 1

CMD ["node", "apps/api/dist/index.js"]
