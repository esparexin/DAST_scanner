    "@securityscan/finding-engine": "workspace:*",
    "@securityscan/reporting": "workspace:*",
    "@securityscan/check-misconfiguration": "workspace:*",
    "@securityscan/check-injection": "workspace:*",
    "@securityscan/check-xss": "workspace:*",
    "@securityscan/check-path-traversal": "workspace:*",
    "@securityscan/risk-engine": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
